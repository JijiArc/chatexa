{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatexa-relay",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Pages allowed to use this relay. Change if the site is hosted somewhere else; empty string = anyone.
    "ALLOWED_ORIGINS": "https://jijiarc.github.io,http://localhost:8000"
  }
}
